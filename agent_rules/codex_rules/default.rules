prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$installer = 'C:\\Users\\Admin\\Downloads\\VSCodeUserSetup-x64.exe'; Invoke-WebRequest -Uri 'https://update.code.visualstudio.com/latest/win32-x64-user/stable' -OutFile $installer; Start-Process -FilePath $installer -ArgumentList '/VERYSILENT','/NORESTART','/MERGETASKS=\"addcontextmenufiles,addcontextmenufolders,addtopath,desktopicon\"' -Wait -WindowStyle Hidden"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$installer = 'C:\\Users\\Admin\\Downloads\\VSCodeUserSetup-x64.exe'; $sig = Get-AuthenticodeSignature -FilePath $installer; if ($sig.Status -ne 'Valid' -or $sig.SignerCertificate.Subject -notmatch 'Microsoft') { throw \"Installer signature check failed: $($sig.Status) $($sig.SignerCertificate.Subject)\" }; $p = Start-Process -FilePath $installer -ArgumentList '/VERYSILENT','/NORESTART','/MERGETASKS=\"addcontextmenufiles,addcontextmenufolders,addtopath,desktopicon\"' -PassThru -WindowStyle Hidden; $p.WaitForExit(); \"InstallerExitCode`t$($p.ExitCode)\""], decision="allow")
