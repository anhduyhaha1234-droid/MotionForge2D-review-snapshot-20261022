  "components": {
    "schemas": {
      "Anchor": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X",
            "default": 0.5
          },
          "y": {
            "type": "number",
            "title": "Y",
            "default": 0.5
          }
        },
        "type": "object",
        "title": "Anchor",
        "description": "Anchor point for compositing (0.0\u20131.0 relative to bbox)."
      },
      "Body_upload_replacement_api_projects__project_id__objects__object_id__replacement_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_replacement_api_projects__project_id__objects__object_id__replacement_post"
      },
      "Body_upload_video_api_projects__project_id__video_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_video_api_projects__project_id__video_post"
      },
      "BoundingBox": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "width": {
            "type": "number",
            "title": "Width"
          },
          "height": {
            "type": "number",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "BoundingBox",
        "description": "Axis-aligned bounding box in pixel coordinates."
      },
      "CreateObjectRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/ObjectKind",
            "default": "character"
          },
          "selection": {
            "$ref": "#/components/schemas/SelectionInput"
          },
          "scene_id": {
            "type": "integer",
            "title": "Scene Id"
          },
          "mask_data": {
            "anyOf": [
              {
                "items": {
                  "items": {
