+_STAGE_CONTRACT = "r6.stage_frame.v1.ffmpeg-ss-30fps-1frame-no-pad"
+_STAGE_RECORD_LIMIT = 4096
+_STAGE_KEYS = {"contract", "source_path", "source_sha256", "sid", "gframe",
+               "output_path", "output_sha256", "output_size"}
